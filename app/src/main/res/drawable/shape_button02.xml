<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33000000">
    <item>
        <shape android:shape="rectangle">
            <!-- Remplacer le dégradé par une couleur marron -->
            <solid android:color="#8B4513"/> <!-- Code couleur marron -->
            <corners android:radius="8dp"/>
            <stroke
                android:width="1dp"
                android:color="#4B2C20"/> <!-- Couleur pour le contour (marron foncé) -->
            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="12dp"
                android:bottom="12dp"/>
        </shape>
    </item>
</ripple>
